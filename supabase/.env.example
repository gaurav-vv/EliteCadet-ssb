# Copy to supabase/.env (gitignored) — read by the Supabase CLI for
# supabase/config.toml. Never commit real values. See docs/email.md.
#
# false = every email is captured by Mailpit (http://127.0.0.1:54324).
# true  = emails go to real inboxes through the SMTP server below.
SMTP_ENABLED=true

# Gmail: your Gmail address and a Google "App password" (16 letters, needs
# 2-Step Verification). Not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

# Where email links (invites, password reset) point. localhost works only on
# this computer. To open them on a phone on the same Wi-Fi, use this computer's
# address (`hostname -I`), e.g. http://192.168.1.20:3000 / :54321, and set
# NEXT_PUBLIC_SUPABASE_URL in .env.local to the same host. See docs/email.md.
AUTH_SITE_URL=https://elite-cadet-ssb-ftzp.vercel.app
AUTH_EXTERNAL_URL=http://10.206.100.125:54321/auth/v1
AUTH_REDIRECT_PATTERN=https://elite-cadet-ssb-ftzp.vercel.app/** 
