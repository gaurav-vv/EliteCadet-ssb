# Copy to supabase/.env (gitignored) and fill in your own values. Read by the
# Supabase CLI for supabase/config.toml (local stack only; the live site's
# email settings are in the Supabase dashboard). Never commit real values.
# See docs/email.md.
#
# false = every email is captured by Mailpit (local email viewer).
# true  = emails go to real inboxes through the SMTP server below.
SMTP_ENABLED=false

# Gmail: your Gmail address and a Google "App password" (16 letters, needs
# 2-Step Verification). Not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password

# Where email links (invites, password reset) point.
# AUTH_SITE_URL / AUTH_REDIRECT_PATTERN: the address the app is opened at.
# AUTH_EXTERNAL_URL: the address of this computer's Supabase (port 54321).
AUTH_SITE_URL=https://your-app.vercel.app
AUTH_EXTERNAL_URL=http://your-computer-ip:54321/auth/v1
AUTH_REDIRECT_PATTERN=https://your-app.vercel.app/**
