# Template for tests/performance/.env.perf (that file is git-ignored; copy this to it).
# Dedicated TEST accounts and TEST data only. Never real users. Never a service-role key.
# `npm run perf:seed-local` writes this file for you against a local Supabase.

PERF_SUPABASE_URL=
PERF_SUPABASE_ANON_KEY=            # the PUBLIC (anon / publishable) key

PERF_STUDENT_EMAIL=
PERF_STUDENT_PASSWORD=
PERF_MENTOR_EMAIL=
PERF_MENTOR_PASSWORD=
PERF_ACADEMY_EMAIL=
PERF_ACADEMY_PASSWORD=
PERF_ADMIN_EMAIL=
PERF_ADMIN_PASSWORD=

# Isolation checks: names that exist ONLY in a second test academy ("|" separated), and the
# names of the student account's classmates. Without PERF_FOREIGN_MARKERS the isolation
# check reports "NOT tested" and fails on purpose.
PERF_FOREIGN_MARKERS=
PERF_PEER_MARKERS=
