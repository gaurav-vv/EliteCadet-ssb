# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
#
# Pick ONE target and use its URL and keys together  -  never mix them:
#
#   LOCAL (your own computer, `npx supabase start`)
#     NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#     Keys: run `npx supabase status -o env` and copy ANON_KEY (or PUBLISHABLE_KEY)
#     and SERVICE_ROLE_KEY (or SECRET_KEY). They are different on every computer,
#     so each person copies their OWN  -  nobody shares keys. Or skip this file and
#     run `npm run dev:local`, which reads them for you.
#
#   HOSTED / PRODUCTION (set these in the hosting provider's environment settings)
#     NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#     Keys: Supabase dashboard -> Project Settings -> API (anon / publishable key
#     and service-role / secret key of THAT project).

# Public  -  safe in the browser. The anon (or "publishable") key is meant to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Service-role key: bypasses Row Level Security. Never prefix it
# with NEXT_PUBLIC_ and never paste it into client code. Needed for staff
# invites (Academy → Students/Mentors), the dev preview below, and recording
# live-meeting attendance from LiveKit webhooks.
# Local Supabase (`npx supabase start`): URL http://127.0.0.1:54321 and the
# keys printed by `npx supabase status`. Remote: Project Settings → API. Never
# mix a local URL with remote keys or the other way round.
SUPABASE_SERVICE_ROLE_KEY=

# Live meeting rooms (Web RTC via LiveKit) — SERVER-ONLY, never NEXT_PUBLIC_.
# See docs/live-meetings.md. Local: ws://localhost:7880 with the key/secret you
# started livekit-server with. Production: your LiveKit Cloud project's
# wss://<project>.livekit.cloud URL and an API key/secret from its settings.
# LIVEKIT_URL is handed to browsers when they join, so it must be reachable
# from them (never localhost in production).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dev-only "Preview as <role>" buttons on the landing page. Off unless set to
# true, and always off in production builds. The preview accounts (including a
# super admin) are created in whichever Supabase project the URL above points
# at, so use a long random password (16+ characters) and prefer a dev project.
DEV_PREVIEW_ENABLED=false
DEV_PREVIEW_PASSWORD=
